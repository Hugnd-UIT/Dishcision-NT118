<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_terms_of_service"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".TermsOfServiceActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="@string/app_name"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/app_name"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBar"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Điều khoản dịch vụ"
                android:textColor="@color/text_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Thỏa thuận chung để khám phá ẩm thực và tham gia cộng đồng Dishcision."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_banner_disclaimer"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bản thảo minh họa · Dùng cho đánh giá pháp lý"
                    android:textColor="#D32F2F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Đây là tài liệu tham khảo giao diện. Bản chính thức sẽ được cập nhật và xác nhận trước khi phát hành chính thức."
                    android:textColor="#555555"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/divider_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Giới thiệu về điều khoản"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Các điều khoản này quy định cách bạn sử dụng ứng dụng Dishcision để khám phá món ăn, chia sẻ công thức, viết đánh giá quán ăn và cùng bạn bè quyết định ăn gì hôm nay. &quot;Bạn&quot; có nghĩa là người dùng ứng dụng."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bằng việc đăng ký hoặc sử dụng ứng dụng, bạn đồng ý tuân thủ các quy định nhằm xây dựng một cộng đồng ẩm thực văn minh, tích cực."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="2. Tài khoản của bạn"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cung cấp thông tin tài khoản chính xác và bảo mật thông tin đăng nhập của bạn. Không mạo danh người khác hoặc sử dụng tài khoản của người khác khi chưa được phép."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bạn chịu trách nhiệm cho mọi hoạt động diễn ra dưới tài khoản của mình. Nếu phát hiện nghi vấn xâm nhập, vui lòng thông báo ngay qua trung tâm hỗ trợ."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="3. Nội dung ẩm thực &amp; Quy chuẩn cộng đồng"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Khi đăng tải bài viết, hình ảnh món ăn, công thức nấu ăn hoặc đánh giá nhà hàng trên Dishcision, hãy đảm bảo nội dung mang tính chân thực, tôn trọng và tuân thủ pháp luật."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nghiêm cấm các bài viết sai sự thật về vệ sinh an toàn thực phẩm, nội dung đả kích, xúc phạm hoặc quảng cáo rác. Dishcision có quyền gỡ bỏ nội dung hoặc khóa tài khoản vi phạm."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="4. Liên hệ &amp; Thay đổi điều khoản"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nếu bạn có bất kỳ câu hỏi nào về Điều khoản dịch vụ hoặc cần hỗ trợ, vui lòng liên hệ với bộ phận CSKH của Dishcision thông qua mục Hỗ trợ trong ứng dụng."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
