<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Header Logo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Dishcision"
        android:textColor="#FF5A36"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- User Brief Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maya Chen"
            android:textColor="#141B2B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="\@mayafoodie"
            android:textColor="#8E7570"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Navigation Menu Items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Item 1: Dành cho bạn -->
        <LinearLayout
            android:id="@+id/menuForYou"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="For You"
                android:src="@drawable/ic_sparkle"
                app:tint="#FF5A36" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Dành cho bạn"
                android:textColor="#141B2B"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 2: Món ăn yêu thích -->
        <LinearLayout
            android:id="@+id/menuFavorites"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Favorite Dishes"
                android:src="@drawable/ic_heart_outline"
                app:tint="#141B2B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Món ăn yêu thích"
                android:textColor="#141B2B"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Item 3: Quán đang theo dõi -->
        <LinearLayout
            android:id="@+id/menuFollowing"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Following Restaurants"
                android:src="@drawable/ic_store"
                app:tint="#141B2B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Quán đang theo dõi"
                android:textColor="#141B2B"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Item 4: Đánh giá -->
        <LinearLayout
            android:id="@+id/menuReviews"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Reviews"
                android:src="@drawable/ic_star_outline"
                app:tint="#5B403A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Đánh giá"
                android:textColor="#141B2B"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Logout Button -->
    <LinearLayout
        android:id="@+id/menuLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Logout"
            android:src="@drawable/ic_logout"
            app:tint="#8E7570" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Đăng xuất"
            android:textColor="#8E7570"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>