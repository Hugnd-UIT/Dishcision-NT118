<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FF"
    android:orientation="vertical">

    <!-- Top Bar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="#141B2B" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Xóa tài khoản"
            android:textColor="#141B2B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tag_chip_pink"
            android:contentDescription="Icon Utensils"
            android:padding="8dp"
            android:src="@drawable/ic_utensils"
            app:tint="#5B403A" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Red Warning Icon Badge -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tag_chip_pink"
                android:contentDescription="Warning"
                android:padding="14dp"
                android:src="@drawable/ic_info"
                app:tint="#E53935" />

            <!-- Headline Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bạn muốn xóa tài khoản?"
                android:textColor="#141B2B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Đây là thao tác nghiêm trọng. Hãy cân nhắc trước khi tiếp tục."
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <!-- Information Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trước khi quyết định"
                    android:textColor="#141B2B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Việc xóa sẽ ảnh hưởng đến khả năng sử dụng tài khoản Dishcision và các nội dung gắn với tài khoản."
                    android:textColor="#505568"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#E9EBF4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Nếu chỉ muốn nghỉ một thời gian, bạn có thể quay lại Cài đặt để quản lý thông báo hoặc đăng xuất."
                    android:textColor="#505568"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Confirmation Checkbox -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/chkConfirmDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonTint="#FF5A36" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="Tôi hiểu tính chất nghiêm trọng và muốn tiếp tục xóa tài khoản."
                    android:textColor="#141B2B"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Disclaimer Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chip_selected_orange"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Warning"
                    android:src="@drawable/ic_info"
                    app:tint="#C2410C" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Chọn ô xác nhận để chủ động tiếp tục. Tài khoản chưa bị xóa trên màn hình này."
                    android:textColor="#5B403A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:id="@+id/btnReturnToSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_light_blue"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quay lại Cài đặt"
                    android:textColor="#141B2B"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnConfirmDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_button_light_small"
                android:clickable="false"
                android:focusable="false"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDeleteBtnText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xóa tài khoản"
                    android:textColor="#8E7570"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>