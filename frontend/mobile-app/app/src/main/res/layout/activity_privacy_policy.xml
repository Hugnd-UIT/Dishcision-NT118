<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_privacy_policy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".PrivacyPolicyActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="@string/app_name"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/app_name"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBar"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Chính sách bảo mật"
                android:textColor="@color/text_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Hiểu rõ cách thu thập, chia sẻ thông tin và các quyền riêng tư của bạn trên Dishcision."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_banner_disclaimer"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bản thảo minh họa · Dùng cho đánh giá pháp lý"
                    android:textColor="#D32F2F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Đây là tài liệu tham khảo giao diện. Bản chính thức sẽ được cập nhật và xác nhận trước khi phát hành chính thức."
                    android:textColor="#555555"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/divider_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Về chính sách bảo mật"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chính sách này giải thích cách Dishcision bảo vệ dữ liệu cá nhân của bạn khi bạn trải nghiệm nền tảng mạng xã hội ẩm thực của chúng tôi."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chúng tôi cam kết bảo vệ thông tin riêng tư và chỉ sử dụng dữ liệu để mang lại trải nghiệm ẩm thực cá nhân hóa tốt nhất cho bạn."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="2. Thông tin chúng tôi thu thập"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Thông tin tài khoản: Bao gồm địa chỉ email, tên người dùng, ảnh đại diện và sở thích ăn uống của bạn để gợi ý món ăn phù hợp."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nội dung cộng đồng: Bao gồm bài viết chia sẻ món ngon, hình ảnh check-in, đánh giá nhà hàng, danh sách món ăn đã lưu và các bình luận công khai."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="3. Cách chúng tôi sử dụng thông tin"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chúng tôi sử dụng thông tin của bạn để vận hành ứng dụng, gợi ý địa điểm ăn uống chuẩn vị, kết nối bạn với những người có cùng gu ẩm thực và nâng cao tính an toàn cho nền tảng."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="4. Chia sẻ thông tin &amp; Quyền riêng tư"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nội dung bạn đăng công khai (như bài viết món ăn, review) sẽ hiển thị với các thành viên khác trong cộng đồng Dishcision. Chúng tôi cam kết không bán dữ liệu cá nhân của bạn cho bên thứ ba."
                android:textColor="#4A4A4A"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
