<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FF"
    android:orientation="vertical">

    <!-- Top Bar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="#141B2B" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sở thích &amp; Dị ứng"
            android:textColor="#141B2B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tag_chip_pink"
            android:contentDescription="Icon Utensils"
            android:padding="8dp"
            android:src="@drawable/ic_utensils"
            app:tint="#5B403A" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Headline Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ăn đúng gu của bạn"
                android:textColor="#141B2B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Điều chỉnh khẩu vị để gợi ý món ăn gần với sở thích hơn."
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <!-- Section 1: Preferred Tastes Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khẩu vị ưu tiên"
                    android:textColor="#141B2B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTasteCountSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:text="4 khẩu vị từ hồ sơ của bạn"
                    android:textColor="#8E7570"
                    android:textSize="12sp" />

                <!-- Taste Chips Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_selected_orange"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="✔ Chua cay"
                        android:textColor="#FF5A36"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_selected_orange"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="✔ Đậm đà"
                        android:textColor="#FF5A36"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_selected_orange"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="✔ Món nước"
                        android:textColor="#FF5A36"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Taste Chips Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_selected_orange"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="✔ Bánh mì sourdough"
                        android:textColor="#FF5A36"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnAddTastePreference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="+ Thêm khẩu vị"
                    android:textColor="#FF5A36"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Section 2: Allergies Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chất gây dị ứng"
                    android:textColor="#141B2B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:text="Chưa thiết lập · Chọn các chất bạn muốn lưu ý."
                    android:textColor="#8E7570"
                    android:textSize="12sp" />

                <!-- Checkboxes -->
                <CheckBox
                    android:id="@+id/chkPeanuts"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Đậu phộng"
                    android:textColor="#141B2B"
                    android:textSize="14sp"
                    app:buttonTint="#FF5A36" />

                <CheckBox
                    android:id="@+id/chkShellfish"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Hải sản có vỏ"
                    android:textColor="#141B2B"
                    android:textSize="14sp"
                    app:buttonTint="#FF5A36" />

                <CheckBox
                    android:id="@+id/chkMilk"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Sữa"
                    android:textColor="#141B2B"
                    android:textSize="14sp"
                    app:buttonTint="#FF5A36" />

                <CheckBox
                    android:id="@+id/chkEggs"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Trứng"
                    android:textColor="#141B2B"
                    android:textSize="14sp"
                    app:buttonTint="#FF5A36" />

                <CheckBox
                    android:id="@+id/chkGluten"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Lúa mì / Gluten"
                    android:textColor="#141B2B"
                    android:textSize="14sp"
                    app:buttonTint="#FF5A36" />

                <CheckBox
                    android:id="@+id/chkSoy"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Đậu nành"
                    android:textColor="#141B2B"
                    android:textSize="14sp"
                    app:buttonTint="#FF5A36" />
            </LinearLayout>

            <!-- Warning Disclaimer Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chip_selected_orange"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Warning"
                    android:src="@drawable/ic_info"
                    app:tint="#C2410C" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Luôn xác nhận với quán"
                        android:textColor="#5B403A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Bộ lọc không bảo đảm an toàn dị ứng. Hãy hỏi quán về nguyên liệu và nguy cơ tiếp xúc chéo trước khi dùng món."
                        android:textColor="#5B403A"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Primary Save Button -->
            <LinearLayout
                android:id="@+id/btnSaveTasteSettings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_button_orange"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lưu tùy chọn"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>