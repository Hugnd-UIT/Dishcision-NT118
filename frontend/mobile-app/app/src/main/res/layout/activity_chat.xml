<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Top Bar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="#141B2B" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tag_chip_pink"
                android:contentDescription="Avatar"
                android:padding="8dp"
                android:src="@drawable/ic_utensils"
                app:tint="#FF5A36" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_indicator" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Direct Chat"
                android:textColor="#141B2B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active now"
                android:textColor="#00A86B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnInfo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Info"
            android:focusable="true"
            android:src="@drawable/ic_info"
            app:tint="#141B2B" />

        <ImageView
            android:id="@+id/btnProfileUser"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_badge_utensils_red"
            android:clickable="true"
            android:contentDescription="Profile User"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_user"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Scrollable Chat Content -->
    <ScrollView
        android:id="@+id/scrollChatHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Food Suggestion Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field_light"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Dishcision Logo"
                    android:src="@drawable/bg_logo_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gợi ý ẩm thực đang mở"
                        android:textColor="#141B2B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Maya &amp; bạn đang cùng thảo luận về Quận 1"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnViewLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Xem vị trí 🎯"
                    android:textColor="#FF5A36"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Time Stamp Divider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="14dp"
                android:background="@drawable/bg_chip_preference"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Hôm nay, 14:30"
                android:textColor="#505568"
                android:textSize="11sp" />

            <!-- Message 1 (Received) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_input_field_light"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="260dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Chào bạn! Quán bún bò Huế hôm qua bạn giới thiệu trên Dishcision ngon xuất sắc luôn á 🍜 Nước dùng đậm đà thơm mùi sả chuẩn vị ghê!"
                    android:textColor="#141B2B"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Message 2 (Received) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tag_chip_pink"
                    android:contentDescription="Small Utensils Icon"
                    android:padding="4dp"
                    android:src="@drawable/ic_utensils"
                    app:tint="#FF5A36" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field_light"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="250dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Tối nay nhóm mình tính đi ăn tiếp, bạn có gợi ý quán lẩu nào gần Quận 1 không?"
                        android:textColor="#141B2B"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Message 3 (Sent) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_button_orange"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="260dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Hihi nghe thích quá! Quận 1 thì thử ngay Lẩu Nấm Dưỡng Sinh bên Bếp Lục Nam xem sao, đang có voucher giảm 20% trên Dishcision đó nha ✨"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Message 4 (Sent) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_orange"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="260dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Mình vừa quay trúng trong vòng quay hôm nay nè, gửi bạn xem menu liền!"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Shared Food Card Attachment -->
            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_white"
                android:elevation="4dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="160dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_image_thumbnail"
                        android:contentDescription="Hotpot Photo" />

                    <!-- Top Badges Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card_white"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="★4.9"
                            android:textColor="#FF8A00"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_verified_green"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="-20% Hội viên"
                            android:textColor="#00A86B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_card_white"
                            android:contentDescription="Bookmark"
                            android:padding="6dp"
                            android:src="@drawable/ic_bookmark"
                            app:tint="#FF5A36" />
                    </LinearLayout>

                    <!-- Bottom Title & Price Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_dark_overlay_tag"
                        android:gravity="center_vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lẩu Nấm Dưỡng Sinh"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="285.000đ"
                            android:textColor="#22C55E"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnCamera"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_button_light_blue"
            android:clickable="true"
            android:contentDescription="Camera"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="10dp"
            android:src="@drawable/ic_camera"
            app:tint="#505568" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field_light"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <EditText
                android:id="@+id/edtChatMessage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Nhập tin nhắn..."
                android:inputType="textShortMessage"
                android:textColor="#141B2B"
                android:textColorHint="#6B7280"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnAttachImage"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Image"
                android:focusable="true"
                android:src="@drawable/ic_image"
                app:tint="#505568" />

            <ImageView
                android:id="@+id/btnMic"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Mic"
                android:focusable="true"
                android:src="@drawable/ic_pencil"
                app:tint="#505568" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnSendMessage"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_fab_add"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Send"
                android:src="@drawable/ic_send"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>