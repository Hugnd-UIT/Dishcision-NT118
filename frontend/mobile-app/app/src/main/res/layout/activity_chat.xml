<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Top Bar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="#141B2B" />

        <ImageView
            android:id="@+id/imgChatAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:contentDescription="Avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_avatar_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#141B2B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Trò chuyện trực tiếp"
                android:textColor="#00A86B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnInfo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Info"
            android:focusable="true"
            android:src="@drawable/ic_info"
            app:tint="#141B2B" />

        <ImageView
            android:id="@+id/btnProfileUser"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_badge_utensils_red"
            android:clickable="true"
            android:contentDescription="Profile User"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_user"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Scrollable Chat Content -->
    <ScrollView
        android:id="@+id/scrollChatHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/progressChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:indeterminateTint="#FF5A36"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEmptyChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Chưa có tin nhắn nào.\nHãy gửi lời chào để bắt đầu cuộc trò chuyện!"
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutMessagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnCamera"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_button_light_blue"
            android:clickable="true"
            android:contentDescription="Image"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="10dp"
            android:src="@drawable/ic_camera"
            app:tint="#505568" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field_light"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <EditText
                android:id="@+id/edtChatMessage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Nhập tin nhắn..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:textColor="#141B2B"
                android:textColorHint="#6B7280"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnAttachImage"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Attach Image"
                android:focusable="true"
                android:src="@drawable/ic_image"
                app:tint="#505568" />

            <TextView
                android:id="@+id/btnQuickEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:text="🍜"
                android:textSize="18sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnSendMessage"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_fab_add"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Send"
                android:src="@drawable/ic_send"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
