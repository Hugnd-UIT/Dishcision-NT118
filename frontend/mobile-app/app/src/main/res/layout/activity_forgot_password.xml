<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_forgot_password"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".ForgotPasswordActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="@string/forgot_password_top_bar"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tvTopBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/btnBack"
                android:text="@string/forgot_password_top_bar"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Forgot Password" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_user" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/containerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBar"
            android:layout_centerInParent="true"
            android:paddingVertical="16dp">

            <RelativeLayout
                android:id="@+id/containerLockIllustration"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_logo_circle"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imgLockIllustration"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/forgot_password_title"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_lock_reset" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/layoutForgotPasswordHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/containerLockIllustration"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvForgotPasswordTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/forgot_password_title"
                    android:textColor="@color/text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Quên mật khẩu?" />

                <TextView
                    android:id="@+id/tvForgotPasswordSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/forgot_password_subtitle"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    tools:text="Vui lòng nhập địa chỉ email đã đăng ký.\nChúng tôi sẽ gửi mã xác nhận cho bạn." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutEmailInputSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layoutForgotPasswordHeader"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/email_register_label"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Email" />

                <RelativeLayout
                    android:id="@+id/containerEmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/imgEmailIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/email_register_label"
                        android:src="@drawable/ic_email" />

                    <EditText
                        android:id="@+id/edtForgotEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/imgEmailIcon"
                        android:background="@null"
                        android:hint="@string/email_hint"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_gray"
                        android:textSize="14sp"
                        tools:hint="Nhập địa chỉ email của bạn" />
                </RelativeLayout>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/btnSendCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_below="@id/layoutEmailInputSection"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/send_code_button"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Gửi mã xác nhận" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/send_code_button"
                        android:src="@drawable/ic_send" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/layoutRememberPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/btnSendCode"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remember_password"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp"
                    tools:text="Nhớ mật khẩu? " />

                <TextView
                    android:id="@+id/tvBackToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/login_link"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Đăng nhập" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSupportFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layoutRememberPassword"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/need_more_help"
                    android:src="@drawable/ic_headset" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/need_more_help"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    tools:text="Cần trợ giúp thêm? " />

                <TextView
                    android:id="@+id/tvContactSupport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/contact_support"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    tools:text="Liên hệ bộ phận hỗ trợ" />
            </LinearLayout>

        </RelativeLayout>
    </RelativeLayout>
</ScrollView>
